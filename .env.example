# Copier en `.env` (ignoré par git) : docker compose le lit automatiquement.
# Secret de signature des tokens de connexion. Obligatoire hors développement.
JWT_SECRET=change-me

# Noms d'utilisateur autorisés à créer un salon (un soleil), séparés par des virgules.
ADMIN_USERNAMES=

# 1 = temps réel (une lettre met 1 minute). 3600 = mode démo : une heure simulée dure une seconde.
LETTER_TIME_SCALE=1

# Autres réglages possibles (valeurs par défaut) :
# LETTER_MIN_DISTANCE=1
# LETTER_MAX_DISTANCE=10
# LETTER_MIN_DELAY=1m
# LETTER_MAX_DELAY=1m
# LETTER_APPROACH=0
