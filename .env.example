# Copier en `.env` (ignoré par git) : docker compose le lit automatiquement.
# Sans docker (`cd web && npm run dev`), mettre ces lignes dans `web/.env`. Sur Vercel : variables d'environnement.

# API partagée de l'atelier (défaut : le serveur de la prof).
# NUXT_PUBLIC_API_BASE=https://gobelins-chat-api.leomouraire.com:4000

# Pseudos (sur le serveur partagé) autorisés à créer et supprimer des salons, séparés par des virgules.
NUXT_PUBLIC_ADMIN_USERNAMES=

# 1 = temps réel (une lettre met 1 minute). 3600 = mode démo : une heure simulée dure une seconde.
NUXT_PUBLIC_LETTER_TIME_SCALE=1

# Autres réglages possibles (valeurs par défaut) :
# NUXT_PUBLIC_LETTER_MIN_DISTANCE=1
# NUXT_PUBLIC_LETTER_MAX_DISTANCE=10
# NUXT_PUBLIC_LETTER_MIN_DELAY=1m
# NUXT_PUBLIC_LETTER_MAX_DELAY=1m
# NUXT_PUBLIC_LETTER_APPROACH=0
